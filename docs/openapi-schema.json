components:
  schemas:
    CabinSeatPaymentMethodEnum:
      enum:
      - cash
      - momo
      type: string
      description: |-
        * `cash` - cash
        * `momo` - momo
    Carrefour:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        zone_id:
          type: integer
          nullable: true
          readOnly: true
        name:
          type: string
          maxLength: 150
        city:
          type: string
          maxLength: 50
        location:
          type: string
          readOnly: true
        is_pickup_point:
          type: boolean
        is_major_intersection:
          type: boolean
        typical_waiting_passengers:
          type: integer
          maximum: 32767
          minimum: 0
        standard_fare_to_centre_fcfa:
          type: integer
          maximum: 2147483647
          minimum: 0
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - location
      - name
      - updated_at
      - zone_id
    CarrefourCreate:
      type: object
      properties:
        zone_id:
          type: integer
          nullable: true
        name:
          type: string
          maxLength: 150
        lat:
          type: number
          format: double
        lng:
          type: number
          format: double
        is_pickup_point:
          type: boolean
          default: true
      required:
      - lat
      - lng
      - name
    CashConfirm:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 100
        ride_id:
          type: string
          default: ''
          maxLength: 32
      required:
      - amount_fcfa
    CorridorLine:
      type: object
      properties:
        id:
          type: string
        code:
          type: string
        city:
          type: string
        name:
          type: string
        start_point:
          type: string
        end_point:
          type: string
        stops:
          type: array
          items:
            type: string
        standard_fare_fcfa:
          type: integer
        distance_km:
          type: number
          format: double
        estimated_duration_min:
          type: integer
      required:
      - city
      - code
      - distance_km
      - end_point
      - estimated_duration_min
      - id
      - name
      - standard_fare_fcfa
      - start_point
      - stops
    CorridorListResponse:
      type: object
      properties:
        success:
          type: boolean
        count:
          type: integer
        data:
          type: array
          items:
            $ref: '#/components/schemas/CorridorLine'
      required:
      - count
      - data
      - success
    DirectionEnum:
      enum:
      - aller
      - retour
      type: string
      description: |-
        * `aller` - aller
        * `retour` - retour
    DriverCorridor:
      type: object
      properties:
        corridor_id:
          type: string
        direction:
          $ref: '#/components/schemas/DirectionEnum'
      required:
      - corridor_id
      - direction
    DriverStatus:
      type: object
      properties:
        is_online:
          type: boolean
        current_location:
          type: object
          additionalProperties:
            type: number
            format: double
      required:
      - current_location
      - is_online
    DriverWithdraw:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 500
        provider:
          $ref: '#/components/schemas/ProviderEnum'
        phone_number:
          type: string
          maxLength: 30
      required:
      - amount_fcfa
      - phone_number
      - provider
    LatLng:
      type: object
      properties:
        lat:
          type: number
          format: double
        lng:
          type: number
          format: double
      required:
      - lat
      - lng
    MobilePayment:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 100
        phone_number:
          type: string
          maxLength: 30
        ride_id:
          type: string
          default: ''
          maxLength: 32
        description:
          type: string
          default: ''
      required:
      - amount_fcfa
      - phone_number
    OTPSend:
      type: object
      properties:
        email:
          type: string
          format: email
        type:
          allOf:
          - $ref: '#/components/schemas/TypeEnum'
          default: signup_verification
      required:
      - email
    OTPVerify:
      type: object
      properties:
        email:
          type: string
          format: email
        otp:
          type: string
          maxLength: 4
          minLength: 4
      required:
      - email
      - otp
    OnlineDriver:
      type: object
      properties:
        id:
          type: string
        username:
          type: string
        email:
          type: string
          format: email
        full_name:
          type: string
        city:
          type: string
        license_plate:
          type: string
          nullable: true
        car_model:
          type: string
          nullable: true
        corridor_line:
          type: string
        available_seats:
          type: integer
        total_seats:
          type: integer
        rating:
          type: number
          format: double
        status:
          type: string
        location:
          $ref: '#/components/schemas/OnlineDriverLocation'
      required:
      - available_seats
      - car_model
      - city
      - corridor_line
      - email
      - full_name
      - id
      - license_plate
      - location
      - rating
      - status
      - total_seats
      - username
    OnlineDriverLocation:
      type: object
      properties:
        lat:
          type: number
          format: double
          nullable: true
        lng:
          type: number
          format: double
          nullable: true
      required:
      - lat
      - lng
    OnlineDriversResponse:
      type: object
      properties:
        success:
          type: boolean
        count:
          type: integer
        data:
          type: array
          items:
            $ref: '#/components/schemas/OnlineDriver'
      required:
      - count
      - data
      - success
    OptimizeTurn:
      type: object
      properties:
        driver_id:
          type: integer
        zone_id:
          type: integer
      required:
      - driver_id
    PassengerTypeEnum:
      enum:
      - vora_app
      - street_pickup
      type: string
      description: |-
        * `vora_app` - vora_app
        * `street_pickup` - street_pickup
    PatchedCabinSeat:
      type: object
      properties:
        is_occupied:
          type: boolean
        passenger_type:
          $ref: '#/components/schemas/PassengerTypeEnum'
        pickup_point:
          type: string
        dropoff_point:
          type: string
        fare_fcfa:
          type: integer
        payment_status:
          $ref: '#/components/schemas/PaymentStatusEnum'
        payment_method:
          $ref: '#/components/schemas/CabinSeatPaymentMethodEnum'
    PaymentStatusEnum:
      enum:
      - paid
      - pending
      type: string
      description: |-
        * `paid` - paid
        * `pending` - pending
    ProviderEnum:
      enum:
      - mtn_momo
      - orange_money
      type: string
      description: |-
        * `mtn_momo` - mtn_momo
        * `orange_money` - orange_money
    RideEstimate:
      type: object
      properties:
        pickup_carrefour_id:
          type: integer
        destination_carrefour_id:
          type: integer
        ride_type:
          allOf:
          - $ref: '#/components/schemas/RideTypeEnum'
          default: shared
        seats_requested:
          type: integer
          maximum: 4
          minimum: 1
          default: 1
      required:
      - destination_carrefour_id
      - pickup_carrefour_id
    RideRate:
      type: object
      properties:
        rating:
          type: integer
          maximum: 5
          minimum: 1
        compliments:
          type: array
          items:
            type: string
        comment:
          type: string
          default: ''
        tip_fcfa:
          type: integer
          minimum: 0
          default: 0
        tip_payment_method:
          allOf:
          - $ref: '#/components/schemas/TipPaymentMethodEnum'
          default: momo
      required:
      - rating
    RideRequest:
      type: object
      properties:
        pickup_carrefour_id:
          type: integer
        pickup_name:
          type: string
          maxLength: 150
        destination_carrefour_id:
          type: integer
        destination_name:
          type: string
          maxLength: 150
        ride_type:
          allOf:
          - $ref: '#/components/schemas/RideTypeEnum'
          default: shared
        seats_count:
          type: integer
          maximum: 4
          minimum: 1
          default: 1
        payment_method:
          $ref: '#/components/schemas/RideRequestPaymentMethodEnum'
        passenger_notes:
          type: string
          default: ''
      required:
      - destination_carrefour_id
      - destination_name
      - payment_method
      - pickup_carrefour_id
      - pickup_name
    RideRequestPaymentMethodEnum:
      enum:
      - cash
      - momo
      - om
      - wallet
      type: string
      description: |-
        * `cash` - cash
        * `momo` - momo
        * `om` - om
        * `wallet` - wallet
    RideTypeEnum:
      enum:
      - shared
      - direct
      type: string
      description: |-
        * `shared` - shared
        * `direct` - direct
    RoleEnum:
      enum:
      - passenger
      - driver
      type: string
      description: |-
        * `passenger` - passenger
        * `driver` - driver
    SOS:
      type: object
      properties:
        ride_id:
          type: string
        location:
          type: object
          additionalProperties: {}
        emergency_type:
          type: string
          default: police_or_danger
        battery_level_percent:
          type: integer
      required:
      - location
    Signin:
      type: object
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    Signup:
      type: object
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          writeOnly: true
          minLength: 8
        role:
          $ref: '#/components/schemas/RoleEnum'
        name:
          type: string
          maxLength: 200
        phone:
          type: string
          maxLength: 30
        vehicle_plate:
          type: string
          maxLength: 30
        corridor_axis:
          type: string
          maxLength: 255
      required:
      - email
      - name
      - password
      - role
    TipPaymentMethodEnum:
      enum:
      - momo
      - om
      - cash
      type: string
      description: |-
        * `momo` - momo
        * `om` - om
        * `cash` - cash
    Trajectory:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        driver_id:
          type: integer
          readOnly: true
        name:
          type: string
          nullable: true
          maxLength: 150
        geometry:
          type: string
          readOnly: true
        tolerance_meters:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - driver_id
      - geometry
      - id
      - updated_at
    TrajectoryCreate:
      type: object
      properties:
        name:
          type: string
          maxLength: 150
        points:
          type: array
          items:
            $ref: '#/components/schemas/LatLng'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
          default: 500
      required:
      - points
    TrajectoryUpdate:
      type: object
      properties:
        name:
          type: string
          maxLength: 150
        points:
          type: array
          items:
            $ref: '#/components/schemas/LatLng'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
        is_active:
          type: boolean
    TypeEnum:
      enum:
      - signup_verification
      - password_reset
      - instant_login
      type: string
      description: |-
        * `signup_verification` - signup_verification
        * `password_reset` - password_reset
        * `instant_login` - instant_login
    VerifyDestination:
      type: object
      properties:
        driver_id:
          type: integer
        destination:
          $ref: '#/components/schemas/LatLng'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
      required:
      - destination
      - driver_id
    Webhook:
      type: object
      properties:
        provider_ref:
          type: string
          maxLength: 128
        status:
          type: string
          default: SUCCESS
      required:
      - provider_ref
    ZoneDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        description:
          type: string
          nullable: true
          maxLength: 255
        boundary:
          type: string
          readOnly: true
        is_active:
          type: boolean
        carrefour_count:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - boundary
      - carrefour_count
      - created_at
      - id
      - name
      - updated_at
    ZoneList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        description:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
