components:
  schemas:
    AuthUser:
      type: object
      properties:
        id:
          type: string
          description: Identifiant public, ex. usr_42
        email:
          type: string
          format: email
        name:
          type: string
        role:
          $ref: '#/components/schemas/RoleEnum'
        vehicle_plate:
          type: string
          nullable: true
        corridor_axis:
          type: string
        redirect_dashboard:
          allOf:
          - $ref: '#/components/schemas/RedirectDashboardEnum'
          description: |-
            Route frontend après connexion

            * `pickup` - pickup
            * `driver-cockpit` - driver-cockpit
        is_verified:
          type: boolean
      required:
      - email
      - id
      - name
      - redirect_dashboard
      - role
    CabinSeatPaymentMethodEnum:
      enum:
      - cash
      - momo
      type: string
      description: |-
        * `cash` - cash
        * `momo` - momo
    Carrefour:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        zone_id:
          type: integer
          nullable: true
          readOnly: true
        name:
          type: string
          maxLength: 150
        city:
          type: string
          maxLength: 50
        location:
          type: string
          readOnly: true
        is_pickup_point:
          type: boolean
        is_major_intersection:
          type: boolean
        typical_waiting_passengers:
          type: integer
          maximum: 32767
          minimum: 0
        standard_fare_to_centre_fcfa:
          type: integer
          maximum: 2147483647
          minimum: 0
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - location
      - name
      - updated_at
      - zone_id
    CarrefourCreateRequest:
      type: object
      properties:
        zone_id:
          type: integer
          nullable: true
        name:
          type: string
          minLength: 1
          maxLength: 150
        lat:
          type: number
          format: double
        lng:
          type: number
          format: double
        is_pickup_point:
          type: boolean
          default: true
      required:
      - lat
      - lng
      - name
    CashConfirmRequest:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 100
        ride_id:
          type: string
          default: ''
          maxLength: 32
      required:
      - amount_fcfa
    CorridorLine:
      type: object
      properties:
        id:
          type: string
        code:
          type: string
        city:
          type: string
        name:
          type: string
        start_point:
          type: string
        end_point:
          type: string
        stops:
          type: array
          items:
            type: string
        standard_fare_fcfa:
          type: integer
        distance_km:
          type: number
          format: double
        estimated_duration_min:
          type: integer
      required:
      - city
      - code
      - distance_km
      - end_point
      - estimated_duration_min
      - id
      - name
      - standard_fare_fcfa
      - start_point
      - stops
    CorridorListResponse:
      type: object
      properties:
        success:
          type: boolean
        count:
          type: integer
        data:
          type: array
          items:
            $ref: '#/components/schemas/CorridorLine'
      required:
      - count
      - data
      - success
    DirectionEnum:
      enum:
      - aller
      - retour
      type: string
      description: |-
        * `aller` - aller
        * `retour` - retour
    DriverCorridorRequest:
      type: object
      properties:
        corridor_id:
          type: string
          minLength: 1
        direction:
          $ref: '#/components/schemas/DirectionEnum'
      required:
      - corridor_id
      - direction
    DriverStatusRequest:
      type: object
      properties:
        is_online:
          type: boolean
        current_location:
          type: object
          additionalProperties:
            type: number
            format: double
      required:
      - current_location
      - is_online
    DriverWithdrawRequest:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 500
        provider:
          $ref: '#/components/schemas/ProviderEnum'
        phone_number:
          type: string
          minLength: 1
          maxLength: 30
      required:
      - amount_fcfa
      - phone_number
      - provider
    LatLngRequest:
      type: object
      properties:
        lat:
          type: number
          format: double
        lng:
          type: number
          format: double
      required:
      - lat
      - lng
    MeResponse:
      type: object
      properties:
        success:
          type: boolean
        data:
          $ref: '#/components/schemas/UserMe'
      required:
      - data
      - success
    MobilePaymentRequest:
      type: object
      properties:
        amount_fcfa:
          type: integer
          minimum: 100
        phone_number:
          type: string
          minLength: 1
          maxLength: 30
        ride_id:
          type: string
          default: ''
          maxLength: 32
        description:
          type: string
          default: ''
      required:
      - amount_fcfa
      - phone_number
    OTPSendRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        type:
          allOf:
          - $ref: '#/components/schemas/TypeEnum'
          default: signup_verification
      required:
      - email
    OTPVerifyData:
      type: object
      properties:
        access_token:
          type: string
        refresh_token:
          type: string
        user:
          $ref: '#/components/schemas/AuthUser'
      required:
      - access_token
      - refresh_token
      - user
    OTPVerifyRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        otp:
          type: string
          minLength: 4
          maxLength: 4
      required:
      - email
      - otp
    OTPVerifyResponse:
      type: object
      properties:
        success:
          type: boolean
        message:
          type: string
        data:
          $ref: '#/components/schemas/OTPVerifyData'
      required:
      - data
      - message
      - success
    OnlineDriver:
      type: object
      properties:
        id:
          type: string
        username:
          type: string
        email:
          type: string
          format: email
        full_name:
          type: string
        city:
          type: string
        license_plate:
          type: string
          nullable: true
        car_model:
          type: string
          nullable: true
        corridor_line:
          type: string
        available_seats:
          type: integer
        total_seats:
          type: integer
        rating:
          type: number
          format: double
        status:
          type: string
        location:
          $ref: '#/components/schemas/OnlineDriverLocation'
      required:
      - available_seats
      - car_model
      - city
      - corridor_line
      - email
      - full_name
      - id
      - license_plate
      - location
      - rating
      - status
      - total_seats
      - username
    OnlineDriverLocation:
      type: object
      properties:
        lat:
          type: number
          format: double
          nullable: true
        lng:
          type: number
          format: double
          nullable: true
      required:
      - lat
      - lng
    OnlineDriversResponse:
      type: object
      properties:
        success:
          type: boolean
        count:
          type: integer
        data:
          type: array
          items:
            $ref: '#/components/schemas/OnlineDriver'
      required:
      - count
      - data
      - success
    OptimizeTurnRequest:
      type: object
      properties:
        driver_id:
          type: integer
        zone_id:
          type: integer
      required:
      - driver_id
    PassengerTypeEnum:
      enum:
      - vora_app
      - street_pickup
      type: string
      description: |-
        * `vora_app` - vora_app
        * `street_pickup` - street_pickup
    PatchedCabinSeatRequest:
      type: object
      properties:
        is_occupied:
          type: boolean
        passenger_type:
          $ref: '#/components/schemas/PassengerTypeEnum'
        pickup_point:
          type: string
        dropoff_point:
          type: string
        fare_fcfa:
          type: integer
        payment_status:
          $ref: '#/components/schemas/PaymentStatusEnum'
        payment_method:
          $ref: '#/components/schemas/CabinSeatPaymentMethodEnum'
    PaymentStatusEnum:
      enum:
      - paid
      - pending
      type: string
      description: |-
        * `paid` - paid
        * `pending` - pending
    ProviderEnum:
      enum:
      - mtn_momo
      - orange_money
      type: string
      description: |-
        * `mtn_momo` - mtn_momo
        * `orange_money` - orange_money
    RedirectDashboardEnum:
      enum:
      - pickup
      - driver-cockpit
      type: string
      description: |-
        * `pickup` - pickup
        * `driver-cockpit` - driver-cockpit
    RideEstimateRequest:
      type: object
      properties:
        pickup_carrefour_id:
          type: integer
        destination_carrefour_id:
          type: integer
        ride_type:
          allOf:
          - $ref: '#/components/schemas/RideTypeEnum'
          default: shared
        seats_requested:
          type: integer
          maximum: 4
          minimum: 1
          default: 1
      required:
      - destination_carrefour_id
      - pickup_carrefour_id
    RideRateRequest:
      type: object
      properties:
        rating:
          type: integer
          maximum: 5
          minimum: 1
        compliments:
          type: array
          items:
            type: string
            minLength: 1
        comment:
          type: string
          default: ''
        tip_fcfa:
          type: integer
          minimum: 0
          default: 0
        tip_payment_method:
          allOf:
          - $ref: '#/components/schemas/TipPaymentMethodEnum'
          default: momo
      required:
      - rating
    RideRequestPaymentMethodEnum:
      enum:
      - cash
      - momo
      - om
      - wallet
      type: string
      description: |-
        * `cash` - cash
        * `momo` - momo
        * `om` - om
        * `wallet` - wallet
    RideRequestRequest:
      type: object
      properties:
        pickup_carrefour_id:
          type: integer
        pickup_name:
          type: string
          minLength: 1
          maxLength: 150
        destination_carrefour_id:
          type: integer
        destination_name:
          type: string
          minLength: 1
          maxLength: 150
        ride_type:
          allOf:
          - $ref: '#/components/schemas/RideTypeEnum'
          default: shared
        seats_count:
          type: integer
          maximum: 4
          minimum: 1
          default: 1
        payment_method:
          $ref: '#/components/schemas/RideRequestPaymentMethodEnum'
        passenger_notes:
          type: string
          default: ''
      required:
      - destination_carrefour_id
      - destination_name
      - payment_method
      - pickup_carrefour_id
      - pickup_name
    RideTypeEnum:
      enum:
      - shared
      - direct
      type: string
      description: |-
        * `shared` - shared
        * `direct` - direct
    RoleEnum:
      enum:
      - passenger
      - driver
      type: string
      description: |-
        * `passenger` - passenger
        * `driver` - driver
    SOSRequest:
      type: object
      properties:
        ride_id:
          type: string
        location:
          type: object
          additionalProperties: {}
        emergency_type:
          type: string
          minLength: 1
          default: police_or_danger
        battery_level_percent:
          type: integer
      required:
      - location
    SigninData:
      type: object
      properties:
        access_token:
          type: string
        token_type:
          type: string
          default: Bearer
        expires_in:
          type: integer
          description: Durée de validité en secondes (86400 = 24 h)
        user:
          $ref: '#/components/schemas/AuthUser'
      required:
      - access_token
      - expires_in
      - user
    SigninRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    SigninResponse:
      type: object
      properties:
        success:
          type: boolean
        message:
          type: string
        data:
          $ref: '#/components/schemas/SigninData'
      required:
      - data
      - message
      - success
    SignupData:
      type: object
      properties:
        user_id:
          type: string
        email:
          type: string
          format: email
        name:
          type: string
        role:
          $ref: '#/components/schemas/RoleEnum'
        is_verified:
          type: boolean
        otp_sent:
          type: boolean
        otp_expires_in_seconds:
          type: integer
      required:
      - email
      - is_verified
      - name
      - otp_expires_in_seconds
      - otp_sent
      - role
      - user_id
    SignupRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 8
        role:
          $ref: '#/components/schemas/RoleEnum'
        name:
          type: string
          minLength: 1
          maxLength: 200
        phone:
          type: string
          maxLength: 30
        vehicle_plate:
          type: string
          maxLength: 30
        corridor_axis:
          type: string
          maxLength: 255
      required:
      - email
      - name
      - password
      - role
    SignupResponse:
      type: object
      properties:
        success:
          type: boolean
        message:
          type: string
        data:
          $ref: '#/components/schemas/SignupData'
      required:
      - data
      - message
      - success
    TipPaymentMethodEnum:
      enum:
      - momo
      - om
      - cash
      type: string
      description: |-
        * `momo` - momo
        * `om` - om
        * `cash` - cash
    Trajectory:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        driver_id:
          type: integer
          readOnly: true
        name:
          type: string
          nullable: true
          maxLength: 150
        geometry:
          type: string
          readOnly: true
        tolerance_meters:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - driver_id
      - geometry
      - id
      - updated_at
    TrajectoryCreateRequest:
      type: object
      properties:
        name:
          type: string
          maxLength: 150
        points:
          type: array
          items:
            $ref: '#/components/schemas/LatLngRequest'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
          default: 500
      required:
      - points
    TrajectoryUpdateRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 150
        points:
          type: array
          items:
            $ref: '#/components/schemas/LatLngRequest'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
        is_active:
          type: boolean
    TypeEnum:
      enum:
      - signup_verification
      - password_reset
      - instant_login
      type: string
      description: |-
        * `signup_verification` - signup_verification
        * `password_reset` - password_reset
        * `instant_login` - instant_login
    UserMe:
      type: object
      properties:
        id:
          type: string
        email:
          type: string
          format: email
        name:
          type: string
        role:
          $ref: '#/components/schemas/RoleEnum'
        phone:
          type: string
        vehicle_plate:
          type: string
          nullable: true
        corridor_axis:
          type: string
        rating:
          type: number
          format: double
        total_rides:
          type: integer
        wallet_balance_fcfa:
          type: integer
      required:
      - corridor_axis
      - email
      - id
      - name
      - phone
      - rating
      - role
      - total_rides
      - wallet_balance_fcfa
    VerifyDestinationRequest:
      type: object
      properties:
        driver_id:
          type: integer
        destination:
          $ref: '#/components/schemas/LatLngRequest'
        tolerance_meters:
          type: integer
          maximum: 5000
          minimum: 50
      required:
      - destination
      - driver_id
    WebhookRequest:
      type: object
      properties:
        provider_ref:
          type: string
          minLength: 1
          maxLength: 128
        status:
          type: string
          minLength: 1
          default: SUCCESS
      required:
      - provider_ref
    ZoneDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        description:
          type: string
          nullable: true
          maxLength: 255
        boundary:
          type: string
          readOnly: true
        is_active:
          type: boolean
        carrefour_count:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - boundary
      - carrefour_count
      - created_at
      - id
      - name
      - updated_at
    ZoneList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        description:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: 'JWT obtenu via `POST /auth/signin` ou `POST /auth/otp/verify`.
        Format header : `Authorization: Bearer <access_token>` — validité 24 h.'
servers:
- url: https://vora-ujbv.onrender.com/api/v1
  description: Production (Render — Frankfurt)
- url: http://localhost:8000/api/v1
  description: Développement local
tags:
- name: System
  description: Santé du service et métadonnées de déploiement.
- name: Auth
  description: 'Inscription, vérification OTP (code fixe **1234** en simulation),
    connexion JWT et profil utilisateur. Deux rôles : `passenger` et `driver`.'
- name: Rides
  description: 'Parcours **passager** : estimation tarif, demande de course, suivi
    statut, paiement à l''arrivée et notation. Nécessite JWT rôle passager côté frontend.'
- name: Driver
  description: 'Parcours **chauffeur taxi jaune** : mise en ligne, sélection de corridor,
    gestion des 4 sièges habitacle, retrait Mobile Money simulé. `GET /drivers/online`
    est public (liste des chauffeurs en ligne).'
- name: Payments
  description: MTN MoMo, Orange Money et espèces — **simulation uniquement**, aucun
    argent réel. Webhooks simulés pour tests d'intégration.
- name: Safety
  description: Alerte SOS avec position GPS — enregistrement signalement + notification
    simulée.
- name: Geolocation
  description: 'Wrapper Google Maps : géocodage, géocodage inverse, itinéraires et
    congestion par zone.'
- name: Zones
  description: Zones urbaines taxi (Yaoundé & Douala) avec limites PostGIS optionnelles.
- name: Carrefours
  description: '32 carrefours seedés (Yaoundé & Douala) : coordonnées GPS, zone, passagers
    en attente typiques, tarif standard vers le centre.'
- name: Corridors
  description: '6 lignes urbaines taxi jaune (Y1–Y3 Yaoundé, D1–D3 Douala) : arrêts,
    tarif standard, distance et durée estimée.'
- name: Driver Trajectories
  description: Corridors de travail déclarés par chauffeur (LineString PostGIS). Utilisés
    par l'optimiseur et `verify-destination`.
- name: Optimization
  description: 'Moteur d''optimisation MVP : matching PostGIS ST_DWithin, sélection
    greedy jusqu''à 4 passagers, heatmap demande.'
- name: Admin
  description: 'Agrégations dashboard : zones, signalements, statistiques journalières.'
externalDocs:
  url: https://github.com/vora-cm/backend/blob/main/Backend_django/docs/API.md
  description: Guide API complet (Markdown)
