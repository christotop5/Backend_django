SECRET_KEY=django-insecure-vora-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# External URL (local dev) — use Internal URL on Render web service
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

GOOGLE_MAPS_API_KEY=

# Must be full URLs with https:// — never set to True/False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://your-frontend.vercel.app

TRAJECTORY_TOLERANCE_METERS=500
SPRING_BOOT_RESERVATION_SERVICE_URL=
