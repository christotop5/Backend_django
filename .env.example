# Django
SECRET_KEY=change-me-generate-a-strong-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL + PostGIS (Render — Internal or External URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Optimization
TRAJECTORY_TOLERANCE_METERS=500
SPRING_BOOT_RESERVATION_SERVICE_URL=https://your-spring-service.onrender.com

# CORS / CSRF (production)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://vora-django-geo.onrender.com

# Gunicorn (optional)
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
